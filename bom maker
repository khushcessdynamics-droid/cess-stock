      metaGrid+
      notesBar+
      '<div style="padding:14px 30px 0;flex:1;">'+renderDocTable(v)+'</div>'+
      sigBlock+
      '<div style="flex:1;"></div>'+
      '<div style="margin-top:20px;padding:11px 30px;border-top:2px solid #16243A;display:flex;justify-content:space-between;align-items:center;gap:14px;">'+
        '<div style="font-size:8px;color:#9AAABA;font-family:\'DM Mono\',monospace;line-height:1.7;"><span style="font-weight:700;color:#C2692C;font-family:\'Inter\',sans-serif;font-size:9.5px;">CESS DYNAMICS</span> · Controlled document — uncontrolled when printed</div>'+
        '<div style="font-size:8px;color:#9AAABA;font-family:\'DM Mono\',monospace;text-align:right;">'+esc(v.dDocno)+' · '+esc(v.dRev)+' · Sheet '+esc(v.dSheet)+' · © '+v.year+'</div>'+
      '</div>'+
    '</div>'+
  '</div>';
}

function render(){
  var v = computeView();
  v.grandTotal = v.grandTotal; // keep

  document.getElementById('bom-topbar').innerHTML = renderTopbar(v);
  document.getElementById('bom-panea').innerHTML = renderPaneA(v);
  document.getElementById('bom-paneb').innerHTML = renderPaneB(v);
  document.getElementById('bom-panec').innerHTML = renderPaneC(v);

  var overlays = document.getElementById('bom-overlays');
  var html = '';
  if (state.toast){
    html += '<div style="position:fixed;bottom:22px;left:50%;background:#1B2A3A;border:1px solid rgba(255,255,255,.14);color:#B6CCDD;padding:9px 22px;border-radius:22px;font-size:12px;z-index:9999;white-space:nowrap;box-shadow:0 8px 24px rgba(0,0,0,.4);animation:bomToastIn .22s ease;transform:translateX(-50%);">'+esc(state.toast)+'</div>';
  }
  if (state.busy){
    html += '<div style="position:fixed;inset:0;background:rgba(11,18,26,.66);backdrop-filter:blur(2px);display:grid;place-items:center;z-index:9998;">'+
      '<div style="display:flex;flex-direction:column;align-items:center;gap:14px;"><div style="width:38px;height:38px;border:3px solid rgba(255,255,255,.15);border-top-color:#D9772E;border-radius:50%;animation:bomSpin .8s linear infinite;"></div>'+
      '<div style="font-size:12px;font-family:\'DM Mono\',monospace;color:#B6CCDD;letter-spacing:.05em;">'+esc(state.busy)+'</div></div></div>';
  }
  overlays.innerHTML = html;

  if (_focusNext != null){
    var ci = _focusNext; _focusNext = null;
    setTimeout(function(){
      var els = document.querySelectorAll('input[data-ci="'+ci+'"][data-field="part"]');
      if (els.length) els[els.length-1].focus();
      else {
        var els2 = document.querySelectorAll('input[data-ci="'+ci+'"][data-field="name"]');
        if (els2.length) els2[els2.length-1].focus();
      }
    }, 30);
  }
}

// ══════════════════════════════════════════════════════════════
// EVENT DELEGATION
// ══════════════════════════════════════════════════════════════

function dispatch(act, target, ev){
  var ci = target.dataset.ci != null ? +target.dataset.ci : null;
  var ii = target.dataset.ii != null ? +target.dataset.ii : null;
  var k = target.dataset.k;
  var mk = target.dataset.mk;
  var field = target.dataset.field;
  var c = target.dataset.c;

  switch(act){
    case 'setDetails': App.setDetails(); break;
    case 'setOptions': App.setOptions(); break;
    case 'openProject': App.openProject(); break;
    case 'saveProject': App.saveProject(); break;
    case 'togglePrice': App.togglePrice(); break;
    case 'exportPNG': App.exportPNG(); break;
    case 'exportPDF': App.exportPDF(); break;
    case 'toggleOpt': App.toggleOpt(k); break;
    case 'toggleMeta': App.toggleMeta(mk); break;
    case 'onDoc': App.onDoc(k, target.value); break;
    case 'onNum': App.onNum(k, target.value); break;
    case 'onCatName': App.onCatName(ci, target.value); break;
    case 'onItem': App.onItem(ci, ii, field, target.value); break;
    case 'addItem': App.addItem(ci); break;
    case 'delItem': App.delItem(ci, ii); break;
    case 'addCat': App.addCat(); break;
    case 'delCat': App.delCat(ci); break;
    case 'toggleColor': App.toggleColor(ci); break;
    case 'pickColor': App.pickColor(ci, c); break;
    case 'moveCatUp': App.moveCatUp(ci); break;
    case 'moveCatDown': App.moveCatDown(ci); break;
    case 'moveItemUp': App.moveItemUp(ci, ii); break;
    case 'moveItemDown': App.moveItemDown(ci, ii); break;
    case 'resetAll': App.resetAll(); break;
    case 'onOpenFile': App.onOpenFile(ev); break;
  }
}

document.addEventListener('click', function(ev){
  var t = ev.target.closest('[data-act]');
  if (!t) return;
  var act = t.dataset.act;
  var passthrough = ['onDoc','onNum','onCatName','onItem','onOpenFile','itemDrag','catDrag'];
  if (passthrough.indexOf(act) !== -1) return;
  dispatch(act, t, ev);
});

document.addEventListener('change', function(ev){
  var t = ev.target;
  var el = t.closest('[data-act]');
  if (!el) return;
  var act = el.dataset.act;
  if (act === 'onDoc' || act === 'onNum' || act === 'onCatName' || act === 'onItem' || act === 'onOpenFile'){
    dispatch(act, el, ev);
  }
});

// drag events (delegated via capture since drag events don't bubble to document reliably in all browsers, but dragstart/dragover/drop do bubble)
document.addEventListener('dragstart', function(ev){
  var t = ev.target.closest('[data-act="catDrag"], [data-act="itemDrag"]');
  if (!t) return;
  if (t.dataset.act === 'catDrag') App.onCatDragStart(ev, +t.dataset.ci);
  else App.onItemDragStart(ev, +t.dataset.ci, +t.dataset.ii);
});
document.addEventListener('dragover', function(ev){
  var t = ev.target.closest('[data-act="catDrag"], [data-act="itemDrag"]');
  if (!t) return;
  if (t.dataset.act === 'catDrag') App.onCatDragOver(ev, +t.dataset.ci);
  else App.onItemDragOver(ev, +t.dataset.ci, +t.dataset.ii);
});
document.addEventListener('drop', function(ev){
  var t = ev.target.closest('[data-act="catDrag"], [data-act="itemDrag"]');
  if (!t) return;
  if (t.dataset.act === 'catDrag') App.onCatDrop(ev, +t.dataset.ci);
  else App.onItemDrop(ev, +t.dataset.ci, +t.dataset.ii);
});
document.addEventListener('dragend', function(ev){
  var t = ev.target.closest('[data-act="catDrag"], [data-act="itemDrag"]');
  if (!t) return;
  App.onDragEnd();
});

// kick off
render();

})();
</script>
</body></html>
